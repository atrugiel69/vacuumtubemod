PKG_NAME="libwebp"
PKG_VERSION="1.6.0"
PKG_LICENSE="BSD-3-Clause"
PKG_SITE="https://developers.google.com/speed/webp"
PKG_URL="https://github.com/webmproject/libwebp/archive/v${PKG_VERSION}.tar.gz"
PKG_DEPENDS_TARGET="toolchain libpng libjpeg-turbo"
